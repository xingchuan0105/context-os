# LiteLLM listener
LITELLM_PORT=4410

# LiteLLM auth (required)
LITELLM_MASTER_KEY=sk-replace-me-master-key
LITELLM_API_KEY=sk-replace-me-master-key
LITELLM_SALT_KEY=sk-replace-me-salt-key

# LiteLLM Postgres (required for model CRUD / usage reports)
LITELLM_DB_USER=litellm
LITELLM_DB_PASSWORD=replace-me-strong-password
LITELLM_DB_NAME=litellm
DATABASE_URL=postgresql://litellm:replace-me-strong-password@litellm-db:5432/litellm
STORE_MODEL_IN_DB=true

# Provider keys (examples)
SILICONFLOW_API_KEY=replace-me
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
DASHSCOPE_API_KEY=replace-me
DEEPSEEK_API_KEY=replace-me
